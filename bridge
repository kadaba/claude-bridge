#!/usr/bin/env python3
"""
bridge — client CLI for the claude-bridge relay. Install on BOTH machines.

A Claude Code instance uses this to talk to its peer. It is stateful: `recv`
and `wait` remember the last message you've seen (per channel) in a cursor file,
so you only ever get new messages.

Config is read from env, falling back to ~/.claude-bridge/config (KEY=VALUE lines):
  BRIDGE_URL     e.g. http://127.0.0.1:8787   (via SSH tunnel — see README)
  BRIDGE_TOKEN   shared secret, must match the relay
  BRIDGE_PEER    THIS instance's name, e.g. 'local' or 'vps'

Usage:
  bridge send  --to vps "message text"          # plain message
  bridge send  --to vps --kind task "do X"      # ask peer to perform a task
  bridge send  --to vps --kind result "output"  # reply with results
  bridge send  --to '*'  "broadcast to everyone"
  bridge recv                                   # print new messages, advance cursor
  bridge recv  --json                           # machine-readable
  bridge wait  --timeout 120                    # block until a message arrives
  bridge tail                                   # stream messages (for a human to watch)
  bridge whoami                                 # show my identity + config
  bridge ping                                   # check relay is reachable
"""
import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

CFG_DIR = os.path.expanduser("~/.claude-bridge")
CFG_FILE = os.path.join(CFG_DIR, "config")


def load_cfg():
    cfg = {}
    if os.path.exists(CFG_FILE):
        with open(CFG_FILE) as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip()
    for k in ("BRIDGE_URL", "BRIDGE_TOKEN", "BRIDGE_PEER"):
        if os.environ.get(k):
            cfg[k] = os.environ[k]
    return cfg


CFG = load_cfg()
URL = (CFG.get("BRIDGE_URL") or "").rstrip("/")
TOKEN = CFG.get("BRIDGE_TOKEN") or ""
PEER = CFG.get("BRIDGE_PEER") or ""


def die(msg):
    print(f"bridge: {msg}", file=sys.stderr)
    sys.exit(1)


def need_cfg():
    if not URL or not TOKEN or not PEER:
        die("missing config. Set BRIDGE_URL, BRIDGE_TOKEN, BRIDGE_PEER "
            f"(env or {CFG_FILE}). Run `bridge whoami` to inspect.")


def api(method, path, body=None, timeout=60):
    req = urllib.request.Request(URL + path, method=method)
    req.add_header("Authorization", f"Bearer {TOKEN}")
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, data=data, timeout=timeout) as r:
            return json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        die(f"HTTP {e.code}: {e.read().decode(errors='replace')}")
    except urllib.error.URLError as e:
        die(f"cannot reach relay at {URL}: {e.reason}")


def cursor_path(channel):
    return os.path.join(CFG_DIR, f"cursor_{PEER}_{channel}")


def read_cursor(channel):
    p = cursor_path(channel)
    if os.path.exists(p):
        try:
            return int(open(p).read().strip())
        except Exception:
            return 0
    return 0


def write_cursor(channel, cid):
    os.makedirs(CFG_DIR, exist_ok=True)
    with open(cursor_path(channel), "w") as f:
        f.write(str(cid))


def fmt(m):
    t = time.strftime("%H:%M:%S", time.localtime(m["ts"]))
    tag = "" if m["kind"] == "msg" else f" [{m['kind']}]"
    return f"[{t}] {m['sender']} → {m['target']}{tag}: {m['body']}"


# --- commands ----------------------------------------------------------------

def cmd_send(a):
    need_cfg()
    text = a.text if a.text is not None else sys.stdin.read()
    r = api("POST", "/send", {
        "from": PEER, "to": a.to, "kind": a.kind,
        "channel": a.channel, "body": text,
    })
    print(f"sent #{r['id']} to {a.to}" + (f" [{a.kind}]" if a.kind != "msg" else ""))


def _drain(channel, wait, timeout):
    """Long-poll once (wait secs). Returns list of new messages, advances cursor."""
    since = read_cursor(channel)
    r = api("GET", f"/poll?peer={PEER}&since={since}&channel={channel}&wait={wait}",
            timeout=timeout)
    msgs = r.get("messages", [])
    if msgs:
        write_cursor(channel, msgs[-1]["id"])
    return msgs


def cmd_recv(a):
    need_cfg()
    msgs = _drain(a.channel, wait=0, timeout=30)
    if a.json:
        print(json.dumps(msgs, indent=2))
    else:
        if not msgs:
            print("(no new messages)")
        for m in msgs:
            print(fmt(m))


def cmd_wait(a):
    need_cfg()
    deadline = time.monotonic() + a.timeout
    while time.monotonic() < deadline:
        remaining = deadline - time.monotonic()
        msgs = _drain(a.channel, wait=min(25, remaining), timeout=remaining + 10)
        if msgs:
            if a.json:
                print(json.dumps(msgs, indent=2))
            else:
                for m in msgs:
                    print(fmt(m))
            return
    print("(timeout: no message received)")
    sys.exit(2)


def cmd_tail(a):
    need_cfg()
    print(f"tailing channel '{a.channel}' as '{PEER}' — Ctrl-C to stop")
    while True:
        for m in _drain(a.channel, wait=25, timeout=40):
            print(fmt(m))


def cmd_whoami(a):
    print(f"peer   : {PEER or '(unset)'}")
    print(f"url    : {URL or '(unset)'}")
    print(f"token  : {'set' if TOKEN else '(unset)'}")
    print(f"config : {CFG_FILE}")


def cmd_ping(a):
    if not URL:
        die("BRIDGE_URL not set")
    r = api("GET", "/health", timeout=10)
    print(f"relay ok, max_id={r.get('max_id')}")


def _blob_url(name):
    return f"{URL}/blob?name={urllib.parse.quote(name)}"


def cmd_put(a):
    need_cfg()
    if not os.path.isfile(a.file):
        die(f"no such file: {a.file}")
    data = open(a.file, "rb").read()
    name = a.name or os.path.basename(a.file)
    req = urllib.request.Request(_blob_url(name), data=data, method="POST")
    req.add_header("Authorization", f"Bearer {TOKEN}")
    req.add_header("Content-Type", "application/octet-stream")
    try:
        with urllib.request.urlopen(req, timeout=600) as r:
            print(json.loads(r.read()))
    except urllib.error.HTTPError as e:
        die(f"HTTP {e.code}: {e.read().decode(errors='replace')}")
    except urllib.error.URLError as e:
        die(f"cannot reach relay: {e.reason}")


def cmd_get(a):
    need_cfg()
    req = urllib.request.Request(_blob_url(a.name))
    req.add_header("Authorization", f"Bearer {TOKEN}")
    try:
        with urllib.request.urlopen(req, timeout=600) as r:
            data = r.read()
    except urllib.error.HTTPError as e:
        die(f"HTTP {e.code}: {e.read().decode(errors='replace')}")
    except urllib.error.URLError as e:
        die(f"cannot reach relay: {e.reason}")
    out = a.out or a.name
    with open(out, "wb") as f:
        f.write(data)
    print(f"wrote {out} ({len(data)} bytes)")


def build_parser():
    p = argparse.ArgumentParser(prog="bridge", description="claude-bridge client")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("send", help="send a message to a peer")
    s.add_argument("text", nargs="?", help="message text (or pipe via stdin)")
    s.add_argument("--to", required=True, help="target peer name, or '*' for broadcast")
    s.add_argument("--kind", default="msg", choices=["msg", "task", "result", "done", "note"])
    s.add_argument("--channel", default="main")
    s.set_defaults(fn=cmd_send)

    s = sub.add_parser("recv", help="print new messages (non-blocking)")
    s.add_argument("--channel", default="main")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_recv)

    s = sub.add_parser("wait", help="block until a message arrives")
    s.add_argument("--channel", default="main")
    s.add_argument("--timeout", type=float, default=120)
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_wait)

    s = sub.add_parser("tail", help="stream messages (for humans)")
    s.add_argument("--channel", default="main")
    s.set_defaults(fn=cmd_tail)

    s = sub.add_parser("whoami", help="show identity + config")
    s.set_defaults(fn=cmd_whoami)

    s = sub.add_parser("ping", help="check relay reachability")
    s.set_defaults(fn=cmd_ping)

    s = sub.add_parser("put", help="upload a file to the relay (SSH-free transfer)")
    s.add_argument("file", help="local file to upload (tar a folder first)")
    s.add_argument("--name", default=None, help="name to store it as (default: basename)")
    s.set_defaults(fn=cmd_put)

    s = sub.add_parser("get", help="download a file previously put on the relay")
    s.add_argument("name", help="stored blob name")
    s.add_argument("--out", default=None, help="output path (default: the name)")
    s.set_defaults(fn=cmd_get)
    return p


if __name__ == "__main__":
    args = build_parser().parse_args()
    args.fn(args)
